{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=report_db;Integrated Security=True;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "GrpcSettings": {
    "ClubServiceUrl": "http://localhost:9001",
    "ClubAccess": {
      "CheckClubExistsTimeoutSeconds": 3,
      "CheckClubPermissionTimeoutSeconds": 3
    },
    "Retry": { "IdempotentUnavailableMaxRetries": 1 }
  },
  "Outbox": { "PollIntervalSeconds": 2, "BatchSize": 20, "LeaseSeconds": 30 },
  "Messaging": { "LegacyPubSubBridgeEnabled": false },
  "JwtSettings": {
    "SecretKey": "your-super-secret-key-min-32-chars!!",
    "Issuer": "fptu-club-system",
    "Audience": "fptu-club-clients"
  }
}
